*.zip

# Exclude large 4K wallpapers (300+ MB)
wallpapers/
*.jpg
*.jpeg
*.png
*.webp

# Screenshots
screenshots/

# System and editor files
.DS_Store
Thumbs.db
*.log
*.tmp

